# ============================================================
# Configuration GxP Copilot - copier en .env et renseigner
# ============================================================

# Selection du fournisseur de modeles : "cloud" (defaut V1) ou "local"
PROVIDER=cloud

# --- Base de donnees (doit correspondre a docker-compose.yml) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gxp
POSTGRES_USER=gxp
POSTGRES_PASSWORD=changeme

# --- Embedding : FIXE, hors abstraction provider (plan §4) ---
# bge-m3 via Ollama dans les DEUX modes (indexation + requete).
# 1024 doit correspondre au schema SQL vector(1024).
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# --- Fournisseur cloud : Mistral (souverain EU) ---
MISTRAL_API_KEY=
MISTRAL_GENERATION_MODEL=mistral-large-latest

# --- Reranking cloud (Cohere) + garde-fou de refus ---
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5
RETRIEVAL_CANDIDATES=20
RERANK_TOP_K=5
RERANK_SCORE_THRESHOLD=0.3

# --- Ollama : generation locale, et embedding dans les deux modes ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERATION_MODEL=llama3.1
